{
  "compilerOptions": {
    "target": "ES2021",
    "module": "commonjs",
    "checkJs": true,
    "maxNodeModuleJsDepth": 1,
    "lib": ["ES2021"]
  },
  "exclude": [
    "node_modules",
    "**/node_modules/*"
  ],
  "typeAcquisition": {
    "enable": true,
    "include": ["scriptable-ios"]
  }
}
